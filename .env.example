# Required runtime configuration. Copy to .env locally; do not commit your copy.
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/foodjournal
DATABASE_USERNAME=foodjournal
DATABASE_PASSWORD=change-me

TELEGRAM_BOT_TOKEN=replace-with-rotated-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-secret
ALLOWED_TELEGRAM_USER_IDS=123456789
DEFAULT_TIMEZONE=Europe/Bucharest

OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.4-mini
AGENT_MAX_TOOL_CALLS=10
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.6-flash
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional integration configuration
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org/api/v2
MANAGEMENT_PORT=8081
FOOD_JOURNAL_SCHEDULING_ENABLED=true
FOOD_JOURNAL_OUTBOX_DELAY_MS=5000

# Terminal profile only. It uses the local foodjournal_dev database and never calls Telegram.
TERMINAL_DATABASE_URL=jdbc:postgresql://localhost:5432/foodjournal_dev
TERMINAL_DATABASE_USERNAME=foodjournal
TERMINAL_DATABASE_PASSWORD=change-me
TERMINAL_TELEGRAM_USER_ID=123456789
TERMINAL_DISPLAY_NAME=Local developer
TERMINAL_EVAL_REPEATS=3
# Optional: run one scenario, compare with a prior ignored JSON report, or redact text in the report.
TERMINAL_EVAL_SCENARIO=
TERMINAL_EVAL_BASELINE_FILE=
TERMINAL_EVAL_FULL_REPORT=true
